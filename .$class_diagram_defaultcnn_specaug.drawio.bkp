  <diagram name="ConvBlockV1-Detail" id="VNXKw5eKciill0Egbvmx">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;b&gt;Input&lt;/b&gt; — feature map (N, C_in, H, W)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;b&gt;Conv2d&lt;/b&gt;(C_in → C_out, kernel 3×3, stride 1, padding 1)&#xa;3×3 sliding window scans the map and extracts local patterns&#xa;(edges, onsets, spectral shapes…) — padding 1 keeps H×W" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="140" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;BatchNorm2d&lt;/b&gt;(C_out)&#xa;normalizes each channel — stable training, generalizes instead of memorizing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="260" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;ReLU&lt;/b&gt;(inplace=True)&#xa;max(0, x) — nonlinearity, learns complex fits faster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="360" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;Output&lt;/b&gt; — (N, C_out, H, W), one feature map per learned pattern" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#333333;" vertex="1" parent="1">
