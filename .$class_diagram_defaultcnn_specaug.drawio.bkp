        <mxCell id="4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#333333;fontSize=11;" value="&lt;b&gt;1. TimeStretch&lt;/b&gt;(rate=0.8, fixed_rate=True, n_freq=F)&#xa;phase-vocoder — stretches the time axis (slower, longer clip)" vertex="1">
