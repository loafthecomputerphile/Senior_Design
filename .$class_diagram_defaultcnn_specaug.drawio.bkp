        <mxCell id="9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#333333;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;BaseSpecAug&lt;/b&gt; (nn.Module)&#xa;─ _n_freq_op : Callable&#xa;─ _n_freq : int | None&#xa;─ n_freq «property get/set»" vertex="1">
