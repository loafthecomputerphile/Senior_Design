        </mxCell>
        <mxCell id="8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#333333;" value="&lt;b&gt;Output&lt;/b&gt; — augmented power spectrogram&#xa;→ Mel / MFCC / Combined pipelines" vertex="1">
          <mxGeometry height="60" width="440" x="300" y="640" as="geometry" />
