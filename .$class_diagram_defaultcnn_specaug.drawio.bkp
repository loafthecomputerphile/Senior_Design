        <mxCell id="6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#333333;fontSize=11;" value="&lt;b&gt;3. FrequencyMasking&lt;/b&gt;(param=5)&#xa;zeroes a band of ≤ 5 frequency bins (SpecAugment)" vertex="1">
          <mxGeometry height="60" width="440" x="300" y="440" as="geometry" />
        </mxCell>
        <mxCell id="7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#333333;fontSize=11;" value="&lt;b&gt;4. TimeMasking&lt;/b&gt;(param=5)&#xa;zeroes a span of ≤ 5 time frames (SpecAugment)" vertex="1">
